l;# Database (used by backend/app/core/database.py)
DB_SERVER=localhost
DB_PORT=3306
DB_NAME=EpiScoutDB
DB_USER=epi_scout
DB_PASSWORD=epi_scout_dev_pw

# Optional LLM re-check after rule-based article matching
LLM_RECHECK_ENABLED=true
LLM_RECHECK_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODEL= openai/gpt-oss-120b:free
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_RECHECK_TIMEOUT_SECONDS=20

# CORS: Danh sách domain frontend được phép gọi API (comma-separated)
# Ví dụ production: https://epi-scout.vercel.app,https://yourdomain.com
CORS_ORIGINS=epi-scout-ai-main.vercel.app

# Mailtrap SMTP Configuration (Cách 2 - SMTP)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=YOUR_MAILTRAP_SMTP_USERNAME_HERE
MAILTRAP_SMTP_PASSWORD=YOUR_MAILTRAP_SMTP_PASSWORD_HERE
MAILTRAP_SENDER_EMAIL=no-reply@episcout.ai
