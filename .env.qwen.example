# Copy to .env only for a NEW installation. Keep existing DB/JWT settings otherwise.
DB_SERVER=127.0.0.1
DB_PORT=3306
DB_NAME=EpiScoutDB
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
SECRET_KEY=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LLM_RECHECK_ENABLED=true
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
LLM_RECHECK_MODEL=episcout-local
LLM_SUMMARY_MODEL=episcout-local
LLM_FALLBACK_MODEL=
LLM_RECHECK_TIMEOUT_SECONDS=600
LLM_SUMMARY_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=1
LLM_REASONING_EFFORT=none
LLM_MAX_INPUT_BYTES=57344
LLM_FEW_SHOT_DATASET_MAX_EXAMPLES=0
GATE_B_ENABLED=true
GATE_B_LLM_ENABLED=false
GATE_B_LLM_FEED_ALLOWLIST=
